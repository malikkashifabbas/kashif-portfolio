# ─────────────────────────────────────────────────────────────────────────────
# Contact form (Resend) — used by app/api/contact/route.ts
#
# Setup:
#   1. Copy this file to ".env.local" (NOT committed to git)
#   2. Sign up at https://resend.com (free — 3,000 emails/month, 100/day)
#   3. Create an API key in the Resend dashboard
#   4. Paste it below
#   5. Restart the dev server: `npm run dev`
# ─────────────────────────────────────────────────────────────────────────────

# Required — your Resend API key (starts with "re_")
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Required — where contact form messages should be delivered
CONTACT_TO_EMAIL=malikkashifabbas28@gmail.com

# Optional — the "From" address shown in your inbox.
# Leave commented to use Resend's default test sender (works immediately).
# To use a custom sender (e.g. portfolio@yourdomain.com), first verify the
# domain in your Resend dashboard, then uncomment + set this:
# CONTACT_FROM_EMAIL=Portfolio <portfolio@yourdomain.com>
